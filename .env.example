# Copy this file to ".env" and fill in your own values.
# DO NOT commit your real .env file to git.

# PostgreSQL connection
DB_USER=postgres
DB_HOST=localhost
DB_NAME=chirpnet
DB_PASSWORD=your_postgres_password
DB_PORT=5432

# JWT
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Server
PORT=5000
